{
  "name": "deepresearch-multi-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多 Agent 协作的行业深度分析助手 · Vue 3 + Netlify Edge Functions + Supabase pgvector",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "type-check:edge": "tsc -p tsconfig.edge.json",
    "smoke": "node scripts/run-smoke.mjs",
    "smoke:ssr": "node scripts/run-ssr.mjs",
    "verify": "npm run type-check && npm run type-check:edge && npm run build && npm run smoke && npm run smoke:ssr",
    "netlify": "npx netlify-cli"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
