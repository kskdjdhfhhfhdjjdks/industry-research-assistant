# ============================================================
# 本地开发环境变量（复制为 .env）
# 线上部署时：请在 Netlify 站点设置 → Environment variables 里配置同名变量
# ============================================================

# --- 大模型（DeepSeek，OpenAI 兼容协议）---
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- 网络检索：三个后端任选其一即可（也可以都填，按优先级自动探测）---
# 优先级：Tavily > 博查 > Serper。想让某个后端生效，请填对应的 key。
# 也可以用 SEARCH_PROVIDER 强制指定，值填 tavily / bocha / serper。

# 【推荐，国内无信用卡可用】博查 Bocha —— 国内合规，支持支付宝/微信，新账号有免费额度
# 注册地址：https://open.bochaai.com  （注册后到「API KEY 管理」创建，另外在「资源包管理」领免费试用）
BOCHA_API_KEY=

# 【国际】Tavily —— 官方明确说明免费版不需要信用卡，但注册通常要 Google 账号
# 申请地址：https://app.tavily.com/home
TAVILY_API_KEY=

# 【国际备用】Serper —— 返回 Google 结果，注册不需要信用卡
# 申请地址：https://serper.dev
SERPER_API_KEY=

# 强制指定检索后端（留空 = 按上面优先级自动选择）
SEARCH_PROVIDER=

# --- Supabase 免费云数据库（pgvector 向量检索 + 长期记忆 + 文档存储）---
# 申请地址：https://supabase.com/dashboard
# 这两个变量会打进前端产物，是公开的；安全依赖数据库的 RLS 行级策略。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
