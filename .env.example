# ============================================================
# 本地开发环境变量（复制为 .env）
# 线上部署时：请在 Netlify 站点设置 → Environment variables 里配置同名变量
# ============================================================

# --- 大模型（DeepSeek，OpenAI 兼容协议）---
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- 网络检索（Tavily，专为 LLM 设计的搜索 API，免费额度 1000 次/月）---
# 申请地址：https://app.tavily.com/home
TAVILY_API_KEY=

# --- Supabase 免费云数据库（pgvector 向量检索 + 长期记忆 + 文档存储）---
# 申请地址：https://supabase.com/dashboard
# 这两个变量会打进前端产物，是公开的；安全依赖数据库的 RLS 行级策略。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
